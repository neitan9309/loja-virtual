{
  "name": "luxury-store-backend",
  "version": "1.0.0",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:create": "psql -U postgres -c \"CREATE DATABASE luxury_store;\"",
    "db:drop": "psql -U postgres -c \"DROP DATABASE IF EXISTS luxury_store;\"",
    "db:schema": "psql -U postgres -d luxury_store -f src/database/schema.sql",
    "db:seed": "psql -U postgres -d luxury_store -f src/database/seeds.sql",
    "db:reset": "npm run db:drop && npm run db:create && npm run db:schema && npm run db:seed",
    "db:setup": "npm run db:create && npm run db:schema && npm run db:seed"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
